.vscode/
.idea/
.vs/
*.user
*.suo
*.tmp
*.temp
*.bak
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini

# Keep documentation and media trackable
!docs/**/*.pdf
!docs/**/*.md
!docs/**/*.png
!docs/**/*.jpg
!docs/**/*.jpeg
!docs/**/*.webp
!docs/**/*.svg
